METHOD process_infotype_0019.
  " Rule: each EC hire/rehire job slice (not 7P) owns exactly one IT0019 task,
  " identified by subtype + task date (TERMN). Emit only tasks PA does not have yet:
  " IT0019 is time constraint 3, so a resend would otherwise add a new SEQNR (max 999).
  DATA: lt_in       TYPE TABLE OF p0019,
        lt_out      TYPE TABLE OF p0019,
        lt_existing TYPE TABLE OF p0019,
        ls_base     TYPE p0019,
        ls_record   TYPE p0019,
        lv_new_date TYPE p0019-begda.

  DATA: lt_payload TYPE ecpao_t_ec_payload_badi,
        wa_payload TYPE ecpao_s_ec_payload_badi,
        wa_field   TYPE ecpao_in_s_field_value_pair,
        lv_event   TYPE string,
        lv_type    TYPE string.

  " BIB record only supplies the base fields; nothing to do without one.
  " pnnnn_tab is fully generic: copy to a typed table before index access.
  lt_in = pnnnn_tab.
  READ TABLE lt_in INTO ls_base INDEX 1.
  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  CALL METHOD get_current_ws4_ws3
    EXPORTING
      pernr      = pernr
      ec_payload = ec_payload
    CHANGING
      ws4_tab    = lt_payload.

  CALL FUNCTION 'HR_READ_INFOTYPE'
    EXPORTING
      pernr         = pernr
      infty         = '0019'
      bypass_buffer = 'X'
    TABLES
      infty_tab     = lt_existing.

  LOOP AT lt_payload INTO wa_payload.
    CLEAR: lv_event, lv_type.
    LOOP AT wa_payload-field_value_pair_tab INTO wa_field.
      CASE wa_field-ec_fld_name.
        WHEN 'event'.
          lv_event = wa_field-ec_fld_value.
        WHEN 'employmentType'.
          lv_type = wa_field-ec_fld_value.
      ENDCASE.
    ENDLOOP.

    CHECK ( lv_event = 'H' OR lv_event = 'R' ) AND lv_type <> '7P'.

    ls_record = ls_base.
    ls_record-seqnr = '000'.
    ls_record-bvmrk = space.
    ls_record-begda = wa_payload-begda.

    IF lv_type = '7A' OR lv_type = '7B'.
      " 7A/7B -> subtype 7V, due in 5 years
      ls_record-subty = '7V'.
      ls_record-tmart = '7V'.

      CALL FUNCTION 'RP_CALC_DATE_IN_INTERVAL'
        EXPORTING
          date      = ls_record-begda
          days      = '00'
          months    = '00'
          years     = 5
        IMPORTING
          calc_date = lv_new_date.
      IF sy-subrc <> 0.
        lv_new_date = ls_record-begda.
      ENDIF.

      ls_record-endda = lv_new_date.
      ls_record-termn = lv_new_date.
      ls_record-bvmrk = '2'.

    ELSEIF lv_type CA '7C 7D 7E 7F 7G 7H'.
      " 7C-7H -> subtype 7B, due in 2 years
      ls_record-subty = '7B'.
      ls_record-tmart = '7B'.

      CALL FUNCTION 'RP_CALC_DATE_IN_INTERVAL'
        EXPORTING
          date      = ls_record-begda
          days      = '00'
          months    = '00'
          years     = 2
        IMPORTING
          calc_date = lv_new_date.
      IF sy-subrc <> 0.
        lv_new_date = ls_record-begda.
      ENDIF.

      ls_record-endda = lv_new_date.
      ls_record-termn = lv_new_date.
      ls_record-bvmrk = '2'.
    ENDIF.

    " Match on task date, not BEGDA: the stored BEGDA can differ from the one sent.
    READ TABLE lt_existing TRANSPORTING NO FIELDS
      WITH KEY subty = ls_record-subty
               termn = ls_record-termn.
    CHECK sy-subrc <> 0.

    APPEND ls_record TO lt_out.
    APPEND ls_record TO lt_existing. " same hire twice in one payload -> one task
  ENDLOOP.

  pnnnn_tab = lt_out.
ENDMETHOD.
