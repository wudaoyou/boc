  METHOD get_current_custom_event.
    DATA:
      lt_ws3                  TYPE ecpao_t_ec_payload_badi,
      wa_ws3                  TYPE ecpao_s_ec_payload_badi,
      lt_custom_event         TYPE ecpao_t_ec_payload_badi,
      lt_custom_event_current TYPE ecpao_t_ec_payload_badi,
      wa_custom_event         TYPE ecpao_s_ec_payload_badi,
      wa_field                TYPE ecpao_in_s_field_value_pair,
      lv_payload_user         TYPE pernr_d.

    CALL METHOD ec_payload->get_ec_payload
      EXPORTING
        ec_templ_id    = 'WS_3'
      IMPORTING
        ec_payload_tab = lt_ws3.

    CALL METHOD ec_payload->get_ec_payload
      EXPORTING
        ec_templ_id    = '9_EVT_REC'
      IMPORTING
        ec_payload_tab = lt_custom_event.

    LOOP AT lt_ws3 INTO wa_ws3.
      CLEAR lv_payload_user.

      READ TABLE wa_ws3-field_value_pair_tab
        INTO wa_field
        WITH KEY ec_fld_name = 'userId'.

      IF sy-subrc = 0.
        lv_payload_user = wa_field-ec_fld_value.
      ENDIF.

      IF lv_payload_user IS NOT INITIAL AND lv_payload_user = pernr.
        LOOP AT lt_custom_event INTO wa_custom_event
          WHERE parent_node_number = wa_ws3-node_number.
          APPEND wa_custom_event TO lt_custom_event_current.
        ENDLOOP.
      ENDIF.
    ENDLOOP.

    custom_event_tab = lt_custom_event_current.
  ENDMETHOD.
