METHOD process_infotype_0105.
  DATA: lt_p0105     TYPE TABLE OF p0105.
  FIELD-SYMBOLS: <fs_p0105> TYPE p0105.
  DATA lt_payload   TYPE ecpao_t_ec_payload_badi.
  DATA lt_ws4_unused TYPE ecpao_t_ec_payload_badi.
  DATA wa_payload   TYPE ecpao_s_ec_payload_badi.
  DATA: lt_fields TYPE TABLE OF ecpao_in_s_field_value_pair,
        wa_fields TYPE ecpao_in_s_field_value_pair.
  DATA lv_email_addr TYPE comm_id_long.
  DATA lv_email_type TYPE string.
  DATA lv_email_subty TYPE p0105-subty.
  DATA lv_email_base_found TYPE abap_bool.
  DATA ls_email TYPE p0105.
  DATA ls_email_base TYPE p0105.

  DATA lt_result TYPE TABLE OF p0105. " Table to collect records to keep

  lt_p0105 = pnnnn_tab.

  " Email processing must not depend on BIB creating subtype 0010.
  READ TABLE lt_p0105 INTO ls_email_base WITH KEY usrty = '0010'.
  IF sy-subrc <> 0.
    READ TABLE lt_p0105 INTO ls_email_base WITH KEY usrty = '0001'.
  ENDIF.
  IF sy-subrc = 0.
    lv_email_base_found = abap_true.
  ENDIF.

  LOOP AT lt_p0105 ASSIGNING <fs_p0105>.
    IF <fs_p0105>-usrty = '0010' OR <fs_p0105>-usrty = '0030'.
      " Replaced below by the independently generated email record.
      CONTINUE.
    ELSEIF <fs_p0105>-usrty <> '0001'.
      " For other types, just add the record and continue
      APPEND <fs_p0105> TO lt_result.
      CONTINUE.
    ENDIF.

    CALL METHOD get_current_ws4_ws3
      EXPORTING
        pernr      = pernr
        ec_payload = ec_payload
      CHANGING
        ws4_tab    = lt_ws4_unused
        ws3_tab    = lt_payload.

    LOOP AT lt_payload INTO wa_payload.
      lt_fields = wa_payload-field_value_pair_tab.

      LOOP AT lt_fields INTO wa_fields.
        CHECK wa_fields-ec_fld_name = 'customString2'.
        CLEAR <fs_p0105>-usrid.
        <fs_p0105>-usrid = wa_fields-ec_fld_value.
      ENDLOOP.

      READ TABLE lt_result TRANSPORTING NO FIELDS
        WITH KEY subty = <fs_p0105>-subty
                 begda = <fs_p0105>-begda
                 endda = <fs_p0105>-endda.
      IF sy-subrc <> 0.
        APPEND <fs_p0105> TO lt_result.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

  CALL METHOD ec_payload->get_ec_payload
    EXPORTING
      ec_templ_id    = 'WS_7'
    IMPORTING
      ec_payload_tab = lt_payload.

  LOOP AT lt_payload INTO wa_payload.
    lt_fields = wa_payload-field_value_pair_tab.
    CLEAR: lv_email_addr, lv_email_type, lv_email_subty.

    LOOP AT lt_fields INTO wa_fields.
      CASE wa_fields-ec_fld_name.
        WHEN 'emailType'.
          lv_email_type = wa_fields-ec_fld_value.
        WHEN 'emailAddress'.
          lv_email_addr = wa_fields-ec_fld_value.
      ENDCASE.
    ENDLOOP.

    CASE lv_email_type.
      WHEN 'B'.
        lv_email_subty = '0010'.
      WHEN 'P'.
        lv_email_subty = '0030'.
      WHEN OTHERS.
        CONTINUE.
    ENDCASE.

    CHECK lv_email_addr IS NOT INITIAL.
    ls_email = ls_email_base.
    IF lv_email_base_found IS INITIAL.
      ls_email-infty = '0105'.
      ls_email-pernr = pernr.
      ls_email-begda = wa_payload-begda.
      ls_email-endda = wa_payload-endda.
    ENDIF.
    ls_email-subty = lv_email_subty.
    ls_email-usrty = lv_email_subty.
    CLEAR ls_email-usrid.
    ls_email-usrid_long = lv_email_addr.

    DELETE lt_result WHERE subty = lv_email_subty
                       AND begda = ls_email-begda
                       AND endda = ls_email-endda.
    APPEND ls_email TO lt_result.
  ENDLOOP.

  pnnnn_tab = lt_result.
ENDMETHOD.
