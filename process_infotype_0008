  METHOD process_infotype_0008.
    CONSTANTS c_annualizationpayfreq TYPE p LENGTH 6 DECIMALS 3 VALUE '26.088'.
    DATA: lt_p0008     TYPE TABLE OF p0008.
    FIELD-SYMBOLS:  <fs_p0008> TYPE p0008.
    DATA lt_payload_11   TYPE ecpao_t_ec_payload_badi.
    DATA wa_payload_11   TYPE ecpao_s_ec_payload_badi.
    DATA lt_payload_4   TYPE ecpao_t_ec_payload_badi.
    DATA wa_payload_4   TYPE ecpao_s_ec_payload_badi.
    DATA:lt_fields TYPE TABLE OF ecpao_in_s_field_value_pair,
         wa_fields TYPE ecpao_in_s_field_value_pair.
    DATA lt_required_lgart TYPE TABLE OF p0008-lga01.
    DATA lv_required_lgart TYPE p0008-lga01.
    DATA lv_lgart_field TYPE string.
    DATA lv_betrg_field TYPE string.
    DATA lv_slot TYPE n LENGTH 2.
    DATA lv_lgart_exists TYPE abap_bool.
    FIELD-SYMBOLS <fs_lgart> TYPE any.
    FIELD-SYMBOLS <fs_betrg> TYPE any.

    DATA lv_ANSAL TYPE string.
    DATA lv_bsgrd TYPE string.

    APPEND '1745' TO lt_required_lgart.
    APPEND '1805' TO lt_required_lgart.

    lt_p0008 = pnnnn_tab.

    " For pay scale area 11, keep only 17xx, 18xx, and 1004 in IT0008.
    DELETE lt_p0008 WHERE trfar = '11'
                      AND lga01 NP '17++'
                      AND lga01 NP '18++'
                      AND lga01 <> '1004'.

    CALL METHOD get_current_ws11
      EXPORTING
        pernr      = pernr
        ec_payload = ec_payload
      CHANGING
        ws11_tab   = lt_payload_11.

    CALL METHOD get_current_ws4_ws3
      EXPORTING
        pernr      = pernr
        ec_payload = ec_payload
      CHANGING
        ws4_tab    = lt_payload_4.



    LOOP AT lt_p0008 ASSIGNING <fs_p0008>.
      "ws-11
      LOOP AT lt_payload_11 INTO wa_payload_11
                     WHERE begda <= <fs_p0008>-endda
                     AND   endda >= <fs_p0008>-begda.
      ENDLOOP.
      IF sy-subrc = 0.
        lt_fields = wa_payload_11-field_value_pair_tab.
        LOOP AT lt_fields INTO  wa_fields.
          IF wa_fields-ec_fld_name = 'customString1'.
            IF wa_fields-ec_fld_value = 'NA'.
              <fs_p0008>-preas = ''.
            ENDIF.
          ENDIF.
        ENDLOOP.
      ENDIF.

      "ws-4
      LOOP AT lt_payload_4 INTO wa_payload_4
               WHERE begda <= <fs_p0008>-endda
               AND   endda >= <fs_p0008>-begda.
      ENDLOOP.
      IF sy-subrc = 0.
        lt_fields = wa_payload_4-field_value_pair_tab.
        LOOP AT lt_fields INTO  wa_fields.
          IF wa_fields-ec_fld_name = 'fte'.
            lv_bsgrd = wa_fields-ec_fld_value * 100.
            <fs_p0008>-bsgrd = lv_bsgrd.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDLOOP.



    LOOP AT lt_p0008 ASSIGNING <fs_p0008>.
      IF <fs_p0008>-trfar <> '11' AND <fs_p0008>-lga01 = '9993'.
        <fs_p0008>-lga01 = '1003'.
        <fs_p0008>-ansal = <fs_p0008>-bet01.
        <fs_p0008>-cpind = 'S'.
        <fs_p0008>-waers = 'CADHR'.
        <fs_p0008>-bet01 = <fs_p0008>-bet01 / c_annualizationpayfreq.

        "clear <fs_p0008>-bet01.

      ELSEIF <fs_p0008>-trfar = '11'.
        CLEAR <fs_p0008>-trfst.
        <fs_p0008>-cpind = 'T'.

        LOOP AT lt_required_lgart INTO lv_required_lgart.
          lv_lgart_exists = abap_false.
          DO 40 TIMES.
            lv_slot = sy-index.
            lv_lgart_field = |LGA{ lv_slot }|.
            ASSIGN COMPONENT lv_lgart_field OF STRUCTURE <fs_p0008> TO <fs_lgart>.
            IF sy-subrc = 0 AND <fs_lgart> = lv_required_lgart.
              lv_lgart_exists = abap_true.
              EXIT.
            ENDIF.
          ENDDO.

          CHECK lv_lgart_exists = abap_false.
          DO 40 TIMES.
            lv_slot = sy-index.
            lv_lgart_field = |LGA{ lv_slot }|.
            ASSIGN COMPONENT lv_lgart_field OF STRUCTURE <fs_p0008> TO <fs_lgart>.
            IF sy-subrc = 0 AND <fs_lgart> IS INITIAL.
              <fs_lgart> = lv_required_lgart.
              lv_betrg_field = |BET{ lv_slot }|.
              ASSIGN COMPONENT lv_betrg_field OF STRUCTURE <fs_p0008> TO <fs_betrg>.
              IF sy-subrc = 0.
                CLEAR <fs_betrg>.
              ENDIF.
              EXIT.
            ENDIF.
          ENDDO.
        ENDLOOP.
      ENDIF.

      IF <fs_p0008>-waers = 'CADHR'.
        <fs_p0008>-bet01 = <fs_p0008>-bet01 * 100.
      ENDIF.
    ENDLOOP.

    pnnnn_tab = lt_p0008.

  ENDMETHOD.
